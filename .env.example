# Copy to .env and fill in values for local Docker development
# Railway: set these in the Railway dashboard under Variables

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# CORS — comma-separated origins for Flutter web (e.g. https://your-app.vercel.app)
# Use * for local development
CORS_ORIGINS=*

# Security (change in production!)
SECRET_KEY=change-me-to-a-random-secret

# Gemini LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_ALLOW_FALLBACK=true

# Firebase (set FIREBASE_MOCK=false and provide credentials for production)
FIREBASE_MOCK=true
FIREBASE_CREDENTIALS_PATH=

# Vercel deployment (set VERCEL_MOCK=false for real deploys)
VERCEL_MOCK=true
VERCEL_AUTH_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# n8n Error Webhook Integration
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/f1d44745-3536-46d6-adc7-cd449e62f4f7
